{
  "name": "aidcp-content",
  "version": "0.1.0",
  "private": true,
  "description": "aidcp-content —— 内容生成 / 发布管线 / 精选库（属主库 aidcp_content）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "test:pg": "AIDCP_PG_INTEGRATION=1 tsx --test 'test/**/*.integration.test.ts'",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "boundaries:refresh": "tsx test/acceptance/helpers/boundary-record.ts refresh",
    "boundaries:census": "tsx test/acceptance/helpers/boundary-record.ts census",
    "start": "tsx --env-file=.env src/server.ts",
    "trigger:like": "tsx src/cli/trigger-like.ts",
    "test:feishu": "tsx --env-file=.env src/cli/test-feishu.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "aidcp-kernel": "git+ssh://git@github.com/tommax-bai/aidcp-kernel.git#94fd279b356b447baee2e3eaddec222e343fb4c7",
    "aidcp-transport": "git+ssh://git@github.com/tommax-bai/aidcp-transport.git#f9a7276a07d4184295f92383080e7d1856f63262",
    "ali-oss": "^6.23.0",
    "pg": "^8.13.1",
    "satori": "0.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
